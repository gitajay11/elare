# Copy to .env and fill in from your Supabase project (Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public site URL, used for canonical links / Open Graph
VITE_SITE_URL=http://localhost:5173

# Razorpay public key id (safe to expose). The key SECRET lives only in Edge Function secrets.
VITE_RAZORPAY_KEY_ID=

# Cross-links between the two sites (each is its own deployment)
VITE_STORE_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174

# Set to "admin" on the admin Vercel project so `npm run build` produces the back-office
# VITE_APP=admin
