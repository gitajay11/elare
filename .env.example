# One env file at the repo root serves every workspace (Vite reads it via envDir,
# the API dev server and the db scripts load it directly). Copy to .env.local.

# ---- Browser (Vite; shipped to both sites) ----------------------------------
# Neon base URL: host + database from your connection string, over https.
# The SDK derives the Managed Auth URL from it.
VITE_NEON_URL=https://ep-xxx.c-0.us-east-1.aws.neon.tech/neondb

# Élaré API (apps/api). Local: the dev server below. Production: the Neon
# Function URL from `neon functions get api`.
VITE_API_URL=http://localhost:8790

# Public site URLs (canonical links + cross-links between the two sites).
# Storefront on the main domain, admin on its subdomain, e.g.
#   https://elare.example.com and https://admin.elare.example.com
VITE_SITE_URL=http://localhost:5173
VITE_STORE_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174

# ---- Server side (never shipped to the browser) ------------------------------
# Written by `neon env pull`; used by pnpm db:migrate and the API.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# API Function env (uploaded by `neon deploy --env .env.local`).
# Comma-separated browser origins allowed to call the API; "http://localhost:*" for local dev.
ALLOWED_ORIGINS=http://localhost:*
MEDIA_BUCKET=media

# Object Storage credential for the media bucket (`neon storage credentials create`).
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Razorpay — optional until the gateway is configured; COD works without it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public key id for the storefront's checkout widget (same value as RAZORPAY_KEY_ID; never the secret).
VITE_RAZORPAY_KEY_ID=

# Order-confirmation email over SMTP (api). Optional: unset SMTP_HOST = no emails.
# Gmail: smtp.gmail.com:587 with an App Password. Brevo/SendGrid/Resend/SES all expose SMTP too.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Élaré Beauty <orders@example.com>"
SUPPORT_EMAIL=hello@example.com
# Absolute storefront URL used for links in emails.
STORE_URL=https://www.elarebeauty.store
