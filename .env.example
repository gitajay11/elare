# ---- Browser (Vite) -------------------------------------------------------
# Neon base URL: the host + database from your connection string, over https.
# The SDK derives the Managed Auth and Data API URLs from it.
VITE_NEON_URL=https://ep-xxx.c-0.us-east-1.aws.neon.tech/neondb

# Public URL of the Élaré API Function (payments + uploads), from `neon functions get api`.
VITE_API_URL=

# Public site URLs (canonical links, cross-links between the two sites)
VITE_SITE_URL=http://localhost:5173
VITE_STORE_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174

# Razorpay public key id (safe to expose). Enables "Pay online" at checkout.
VITE_RAZORPAY_KEY_ID=

# Set to "admin" on the admin Vercel project so `npm run build` produces the back-office
# VITE_APP=admin

# ---- Server side (never shipped to the browser) ----------------------------
# Written by `neon env pull` / `neon link`; used by `npm run db:migrate`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Function env (uploaded by `neon deploy --env .env.local`)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
