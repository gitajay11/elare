{
  "name": "elare-beauty",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @elare/db migrate",
    "db:test": "pnpm --filter @elare/db test",
    "api:dev": "pnpm --filter @elare/api dev",
    "api:build": "pnpm --filter @elare/api build",
    "storefront:dev": "pnpm --filter @elare/storefront dev",
    "admin:dev": "pnpm --filter @elare/admin dev"
  },
  "devDependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "turbo": "^2.5.6",
    "typescript": "^5.9.0"
  }
}
